{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghclone",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghclone",
      "database_id": "be032b09-514b-48e0-b484-562079d7a86a",
      "migrations_dir": "migrations"
    }
  ]
}
